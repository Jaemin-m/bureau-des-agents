{
  "name": "bureau-des-agents",
  "version": "0.1.0",
  "private": true,
  "description": "에이전트 사무실: 원하는 걸 말하면 Claude Code 에이전트 팀이 픽셀 아트 사무실에서 눈앞에 일을 시작해요. VibesMoney의 Le Bureau des agents를 한국어로 옮긴 포크(MIT).",
  "license": "MIT",
  "author": "VibesMoney (https://vibesmoney.com)",
  "homepage": "https://github.com/devlikemasta/bureau-des-agents#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devlikemasta/bureau-des-agents.git"
  },
  "bugs": {
    "url": "https://github.com/devlikemasta/bureau-des-agents/issues"
  },
  "keywords": [
    "claude-code",
    "agents",
    "ai-agents",
    "pixel-art",
    "subagents",
    "vibesmoney"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node scripts/check-node.mjs && vite build --logLevel warn && node server/index.ts --open",
    "dev": "node scripts/dev.ts",
    "build": "vite build",
    "serve": "node server/index.ts",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p server/tsconfig.json && tsc --noEmit -p tests/tsconfig.json",
    "test": "node --test \"tests/**/*.test.ts\"",
    "snapshot-demo": "node scripts/snapshot-demo.ts"
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "galmuri": "^2.40.3",
    "marked": "^18.1.1",
    "pretendard": "^1.3.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.22.0",
    "zustand": "^5.0.15",
    "zzfx": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
